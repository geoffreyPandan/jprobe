+# include <sys/prctl.h>
+#endif
+
+gpointer
+gum_ffi_closure_alloc (gsize size,
+                       gpointer * code)
+{
+  gpointer result;
+
+  result = ffi_closure_alloc (size, code);
+
+#ifdef HAVE_ANDROID
+  if (result != NULL)
+  {
+    gint saved_errno = errno;
+    gsize page_size = gum_query_page_size ();
+    gsize mask = ~(page_size - 1);
+    gsize writable_page = GPOINTER_TO_SIZE (result) & mask;
+    gsize executable_page = GPOINTER_TO_SIZE (*code) & mask;
+
+    /* libffi allocates closure pages outside Gum's allocator. Attribute only
+     * the pages it just handed us; file-backed aliases keep their own names.
+     * Naming is optional and must not change allocation or errno semantics. */
+    prctl (PR_SET_VMA, PR_SET_VMA_ANON_NAME, writable_page, page_size,
+        (gulong) "jprobe-closure");
+    if (executable_page != writable_page)
+      prctl (PR_SET_VMA, PR_SET_VMA_ANON_NAME, executable_page, page_size,
+          (gulong) "jprobe-closure");
+    errno = saved_errno;
+  }
+#endif
+
+  return result;
+}
 
