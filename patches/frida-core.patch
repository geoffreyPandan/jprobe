-  }
-  else
-  {
-    FridaBreakpoint * breakpoint = &self->breakpoints[n];
-
-    if (breakpoint->address != 0)
-      frida_spawn_instance_overwrite_arm64_instruction (self, breakpoint->address, breakpoint->original);
