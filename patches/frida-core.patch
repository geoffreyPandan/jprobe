-    x86_debug_state64_t * ds = &s->uds.ds64;
-
-    ((guint64 *) &ds->__dr0)[n] = break_at;
-    if (break_at != 0)
-      ds->__dr7 |= 1 << (n * 2);
-    else
-      ds->__dr7 &= ~(1 << (n * 2));
