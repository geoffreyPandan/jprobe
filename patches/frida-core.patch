-static void
-frida_rmtree (GFile * file)
-{
-  GFileEnumerator * enumerator =
-      g_file_enumerate_children (file, G_FILE_ATTRIBUTE_STANDARD_NAME, G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS, NULL, NULL);
