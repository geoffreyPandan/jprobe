-      ds->__dr7 |= 1 << (n * 2);
-    else
-      ds->__dr7 &= ~(1 << (n * 2));
-  }
-#else
-# define FRIDA_S_USER ((uint32_t) (2u << 1))
-# define FRIDA_BAS_ANY ((uint32_t) 15u)
-# define FRIDA_BAS_THUMB ((uint32_t) 12u)
