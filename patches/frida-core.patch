-        if ((insn->id == ARM_INS_BX || insn->id == ARM_INS_BXJ) &&
-            insn->detail->arm.operands[0].type == ARM_OP_REG &&
-            insn->detail->arm.operands[0].reg == ARM_REG_LR)
-        {
-          match = insn->address;
-          break;
-        }
