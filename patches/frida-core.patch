-
-					uint pid = (uint) uint64.parse (m.fetch (3));
-					Gum.Address caller = uint64.parse (m.fetch (4), 16);
-
-					uint task = 0;
-					try {
-						task = DarwinHelperBackend.task_for_pid (pid);
-
-						bool caller_is_dyld = false;
