-      break;
-
-    case GUM_CPU_AMD64:
-      cs_arch_register_x86 ();
-      err = cs_open (CS_ARCH_X86, CS_MODE_64, &capstone);
-      break;
-#endif
-
-#if defined (HAVE_ARM) || defined (HAVE_ARM64)
-    case GUM_CPU_ARM:
-      cs_arch_register_arm ();
