-  cs_err err;
-  gpointer chunk;
-  cs_insn * insn;
-  const uint8_t * code;
-  size_t size;
-
-  capstone = frida_create_capstone (cpu_type, start);
-
-  err = cs_option (capstone, CS_OPT_DETAIL, CS_OPT_ON);
