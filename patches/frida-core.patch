-  local_address = g_strdup_printf ("pipe:port=0x%x", local_rx);
-  remote_address = g_strdup_printf ("pipe:port=0x%x", remote_rx);
-  local_rx = MACH_PORT_NULL;
-  remote_rx = MACH_PORT_NULL;
