-    pc_may_need_fixup_due_to_ptrauth_failure = gum_strip_code_address (GUM_ADDRESS (state.ts_64.__opaque_pc)) == ret_gadget;
-    if (pc_may_need_fixup_due_to_ptrauth_failure)
