-    frida_spawn_instance_send_breakpoint_response (self);
-
-    return;
-  }
-
-  for (i = 0; i != FRIDA_MAX_BREAKPOINTS; i++)
-  {
-    if ((self->breakpoints[i].address & ~1) == (pc & ~GUM_ADDRESS (1)))
