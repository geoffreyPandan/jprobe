-
-    for (i = 0; i != FRIDA_MAX_BREAKPOINTS; i++)
-    {
-      FridaBreakpoint * bp = &self->breakpoints[i];
-      if (bp->repeat != FRIDA_BREAKPOINT_REPEAT_NEVER)
