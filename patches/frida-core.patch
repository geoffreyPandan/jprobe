-  }
-bsd_failure:
-  {
-    g_set_error (error,
-        FRIDA_ERROR,
-        FRIDA_ERROR_NOT_SUPPORTED,
-        "Unexpected error while preparing pipe endpoints for process with pid %u (%s returned '%s')",
-        remote_pid, failed_operation, g_strerror (errno));
