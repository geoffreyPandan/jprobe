-      case EXC_BREAKPOINT:
-        g_string_append (message, "an unknown breakpoint");
-        break;
-      case EXC_CRASH:
-        g_string_append (message, "a crash");
-        break;
-      case EXC_RESOURCE:
-        g_string_append (message, "a resource limit");
