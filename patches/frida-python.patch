-    case G_VARIANT_CLASS_BYTE:
-      return PyLong_FromLong (g_variant_get_byte (variant));
-    case G_VARIANT_CLASS_INT16:
-      return PyLong_FromLong (g_variant_get_int16 (variant));
-    case G_VARIANT_CLASS_UINT16:
