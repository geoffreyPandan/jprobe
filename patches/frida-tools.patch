-
-        try:
-            worker.join(timeout)
-        except KeyboardInterrupt:
-            self._reactor.cancel_io()
-
-        if timeout is not None and worker.is_alive():
-            self._reactor.cancel_io()
-            while worker.is_alive():
-                try:
-                    worker.join()
-                except KeyboardInterrupt:
-                    pass
-
-        error = result[1]
-        if error is not None:
-            raise error
-
-        return result[0]
