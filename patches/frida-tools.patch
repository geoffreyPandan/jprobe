-class ChunkType(IntEnum):
-    STRING_POOL = 0x001
-    XML = 0x003
-    START_ELEMENT = 0x102
-    RESOURCE_MAP = 0x180
-
-
-class ResourceType(IntEnum):
-    BOOL = 0x12
-
-
-class StringType(IntEnum):
-    UTF8 = 1 << 8
-
