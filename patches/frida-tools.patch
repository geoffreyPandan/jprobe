+    for bridge in ["java", "objc", "swift"]:
+        for source in (priv_dir / "node_modules" / ("frida-" + bridge + "-bridge")).rglob("*.js"):
+            original = source.read_text()
+            updated = original.replace("Frida.", "Jprobe.")
+            updated = updated.replace("'frida'", "'jprobe'").replace('"frida"', '"jprobe"')
+            if updated != original:
+                source.write_text(updated)
