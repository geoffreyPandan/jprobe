-        while True:
-            res = self._service.request({"type": "read-events"})
-            events = res["events"]
-            processes = res["processes"]
-            status = res["status"]
-
-            for pid, abi in processes:
-                self._abi_by_pid[pid] = abi
-
-            for row in events:
-                ev = self._parse_event_row(row)
-
-                if (ev.abi, ev.nr) in self._excluded:
-                    continue
-
-                self._events_out.put(ev)
-
-            if events:
-                self._notify_ui()
-
-            if status != "more":
-                break
-
-        self._notify_ui()
