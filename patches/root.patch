diff --git a/meson.build b/meson.build
index c4dc348..1e7e805 100644
--- a/meson.build
+++ b/meson.build
@@ -1,22 +1,39 @@
-project('frida', 'c',
+project('jprobe', 'c',
   version: run_command('releng' / 'frida_version.py', check: true).stdout().strip(),
   meson_version: '>=1.1.0',
 )
 
+add_languages('cpp', native: false)
+
+# Cover dependencies and separate compatibility builds as well as this project.
+if not meson.is_subproject() and meson.get_compiler('c').get_id() in ['clang', 'gcc']
+  jp_fs = import('fs')
+  foreach part : ['', 'subprojects/frida-core', 'subprojects/frida-gum',
+                  'subprojects/frida-core/subprojects/frida-gum',
+                  'subprojects/frida-core/subprojects/efni']
+    actual = meson.project_source_root() / part
+    relative = jp_fs.relative_to(actual, meson.project_build_root())
+    normalized = '/src/jprobe' / part.replace('frida', 'jprobe')
+    add_global_arguments('-ffile-prefix-map=' + actual + '=' + normalized,
+                         '-ffile-prefix-map=' + relative + '=' + normalized,
+                         language: ['c', 'cpp'])
+  endforeach
+endif
+
 python = import('python').find_installation()
 
 is_cross_build = meson.is_cross_build()
 is_watchos = host_machine.subsystem().split('-')[0] == 'watchos'
 
 gum_options = [
-  'frida_version=' + meson.project_version(),
+  'jprobe_version=' + meson.project_version(),
   'graft_tool=' + (get_option('graft_tool').disable_auto_if(is_cross_build).allowed() ? 'enabled' : 'disabled'),
   'gumjs=enabled',
 ]
 subproject('frida-gum', default_options: gum_options)
 
 core_options = [
-  'frida_version=' + meson.project_version(),
+  'jprobe_version=' + meson.project_version(),
 ]
 core_options += 'gadget=' + (get_option('gadget').disable_auto_if(not is_cross_build).allowed() ? 'enabled' : 'disabled')
 foreach component : ['server', 'portal', 'inject']
@@ -29,11 +46,11 @@ subproject('frida-core', default_options: core_options)
 
 ensure_submodules = [python, files('tools' / 'ensure-submodules.py')]
 
-if get_option('frida_net') \
+if get_option('jprobe_net') \
     .disable_auto_if(is_cross_build) \
     .allowed()
   dotnet = find_program('dotnet', required: false)
-  if get_option('frida_net') \
+  if get_option('jprobe_net') \
       .disable_auto_if(not dotnet.found()) \
       .allowed()
     run_command(ensure_submodules, 'frida-net', check: true)
@@ -41,21 +58,21 @@ if get_option('frida_net') \
   endif
 endif
 
-if get_option('frida_node') \
+if get_option('jprobe_node') \
     .disable_auto_if(is_cross_build) \
     .allowed()
   run_command(ensure_submodules, 'frida-node', check: true)
   subproject('frida-node')
 endif
 
-if get_option('frida_python') \
+if get_option('jprobe_python') \
     .disable_auto_if(is_cross_build) \
     .allowed()
   run_command(ensure_submodules, 'frida-python', check: true)
   subproject('frida-python')
 endif
 
-if get_option('frida_swift') \
+if get_option('jprobe_swift') \
     .disable_auto_if(is_cross_build) \
     .disable_auto_if(build_machine.system() != 'macos') \
     .allowed()
@@ -63,11 +80,11 @@ if get_option('frida_swift') \
   subproject('frida-swift')
 endif
 
-if get_option('frida_qml') \
+if get_option('jprobe_qml') \
     .disable_auto_if(is_cross_build) \
     .allowed()
   qt6_dep = dependency('qt6', modules: ['Core'], required: false)
-  if get_option('frida_qml') \
+  if get_option('jprobe_qml') \
       .disable_auto_if(not qt6_dep.found()) \
       .allowed()
     run_command(ensure_submodules, 'frida-qml', check: true)
@@ -75,7 +92,7 @@ if get_option('frida_qml') \
   endif
 endif
 
-if get_option('frida_tools') \
+if get_option('jprobe_tools') \
     .disable_auto_if(is_cross_build) \
     .allowed()
   run_command(ensure_submodules, 'frida-tools', check: true)
